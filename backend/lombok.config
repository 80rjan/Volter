# Root config: stop Lombok from looking in parent directories.
config.stopBubbling = true

# Copy these field annotations onto the constructor parameters that Lombok
# generates (@RequiredArgsConstructor/@AllArgsConstructor). Without this, an
# annotation like @Lazy placed on a final field is dropped and never reaches
# the constructor parameter, so Spring won't inject a lazy proxy.
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
