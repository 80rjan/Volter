# Run: docker compose --env-file .env.dev -f docker-compose.dev.yml up --build

# ---- PostgreSQL (dev database) ----
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ---- Backend ----
# 32-byte base64 secret. A fixed dev value is fine.
JWT_CONFIG_SECRET=
# CORS origin = the Vite dev server.
ALLOWED_ORIGINS=
# Optional goldapi.io key (leave blank to disable the live gold price).
GOLD_API_KEY=
