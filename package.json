{
  "name": "volter_software",
  "productName": "Volter A&B",
  "author": "Borjan Gjorgjievski",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build": "electron-builder",
    "start-backend": "node backend/server.js",
    "start-frontend": "npm --prefix frontend run dev",
    "build-frontend": "vite build --config frontend/vite.config.js",
    "start-electron": "npx electron --trace-warnings main.js",
    "dev": "concurrently \"npm run start-backend\" \"npm run start-frontend\" \"npm run start-electron\"",
    "start": "npm run dev"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^6.4.6",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "1.8.2",
    "concurrently": "^7.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-async-handler": "^1.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.476.0",
    "pg": "^8.13.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.5.0",
    "styled-components": "^6.1.15",
    "vite": "6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "electron": "^34.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.volter.pawnshop",
    "productName": "Volter A&B",
    "win": {
      "target": "nsis",
      "icon": "frontend/public/V.ico"
    },
    "files": [
      "main.js",
      "frontend/dist/**/*",
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".env",
        "to": ".env"
      }
    ],
    "asarUnpack": [
      "backend"
    ]
  }
}
